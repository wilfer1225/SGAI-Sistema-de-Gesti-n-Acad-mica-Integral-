# PostgreSQL (DATABASE_URL prevalece si está definido)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgai
DB_USER=sgai
DB_PASSWORD=sgai_dev_password
# Desarrollo local con docker compose: postgres://sgai:sgai_dev_password@localhost:5432/sgai
# DATABASE_URL=postgresql://sgai:sgai_dev_password@localhost:5432/sgai

# Obligatorio al desplegar con NODE_ENV=production. Usar un valor aleatorio largo.
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
