# Copiá este archivo como ".env" (sin el ".example") y completá los valores reales.
# El archivo ".env" NUNCA se sube a Git (ya está listado en .gitignore).

# Puerto donde corre el backend
PORT=3000

# Secreto usado para firmar los JWT de autenticación.
# Generá uno propio y random, por ejemplo con: openssl rand -base64 32
JWT_SECRET=reemplazar_por_un_secreto_largo_y_random

# Para cuando se migre de datos simulados (mockData.js) a PostgreSQL real:
DATABASE_URL=postgresql://usuario:password@localhost:5432/sgai_db
